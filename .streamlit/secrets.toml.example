# Copier ce fichier en `.streamlit/secrets.toml` et remplir les valeurs.
# Ce fichier .example est versionné ; secrets.toml ne l'est PAS (voir .gitignore).

[auth]
# Passe à true (ou définis la variable d'env RISK_REQUIRE_AUTH=1) pour exiger une
# connexion — mode multi-utilisateur / déploiement cloud. En local, laisse false.
require = false

[email]
enabled = false
smtp_host = "smtp.gmail.com"
smtp_port = 587
sender = "oladedossoukohi@gmail.com"
# Mot de passe d'application Gmail (16 caractères, PAS le mot de passe du compte)
# https://myaccount.google.com/apppasswords
app_password = ""
recipient = "oladedossoukohi@gmail.com"

[ntfy]
enabled = false
# Choisir un topic privé difficile à deviner, puis s'abonner depuis l'app ntfy sur mobile.
topic = "risk-guard-oladed-xxxx"
server = "https://ntfy.sh"
